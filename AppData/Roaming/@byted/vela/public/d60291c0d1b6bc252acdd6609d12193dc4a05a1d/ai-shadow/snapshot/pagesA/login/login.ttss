/* 登录页面样式 */
page {
  background-color: #F5F1EB;
  height: 100%;
}

.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F5F1EB;
}

.login-header {
  padding: 20px 16px 0 16px;
  height: 48px;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.05);
}

.back-icon {
  width: 10px;
  height: 10px;
  border-left: 2px solid #333;
  border-bottom: 2px solid #333;
  transform: rotate(45deg);
  margin-left: 3px;
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28px;
}

/* 品牌区域 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 32px;
  padding-bottom: 20px;
}

.brand-icon {
  width: 72px;
  height: 72px;
  border-radius: 20px;
  background: linear-gradient(135deg, #5B8C5A 0%, #87C687 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  box-shadow: 0 8px 24px rgba(91, 140, 90, 0.25);
}

.brand-icon-text {
  font-size: 32px;
  color: #FFFFFF;
  font-weight: 700;
}

.brand-name {
  font-size: 20px;
  font-weight: 700;
  color: #2C2C2C;
  margin-bottom: 6px;
}

.brand-slogan {
  font-size: 13px;
  color: #999;
  letter-spacing: 1px;
}

/* 授权声明卡片 */
.auth-notice {
  width: 100%;
  background-color: #F0F7F0;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 16px;
  box-sizing: border-box;
  border: 1px solid #D4E8D4;
}

.notice-title {
  font-size: 13px;
  font-weight: 600;
  color: #4A7A49;
  display: block;
  margin-bottom: 8px;
}

.notice-copy {
  font-size: 12px;
  color: #6B9A6A;
  line-height: 1.8;
  display: block;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 24px 20px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.card-title {
  font-size: 18px;
  font-weight: 600;
  color: #2C2C2C;
  text-align: center;
  margin-bottom: 6px;
}

.card-desc {
  font-size: 12px;
  color: #999;
  text-align: center;
  margin-bottom: 20px;
}

/* 抖音一键登录按钮 */
.douyin-login-btn {
  width: 100%;
  height: 48px;
  background: linear-gradient(135deg, #5B8C5A 0%, #6AA669 100%);
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
}

.douyin-login-btn::after {
  border: none;
}

.douyin-login-btn .douyin-icon {
  width: 22px;
  height: 22px;
  margin-right: 8px;
}

.douyin-login-btn .btn-text {
  font-size: 16px;
  color: #FFFFFF;
  font-weight: 600;
}

.login-btn-loading {
  opacity: 0.7;
}

/* 分割线 */
.divider-row {
  display: flex;
  align-items: center;
  margin: 20px 0 16px 0;
}

.divider-line {
  flex: 1;
  height: 1px;
  background-color: #E8E8E8;
}

.divider-text {
  font-size: 12px;
  color: #BFBFBF;
  margin: 0 12px;
  flex-shrink: 0;
}

/* 手机号登录表单 */
.form-group {
  margin-bottom: 12px;
}

.form-input {
  display: flex;
  align-items: center;
  height: 46px;
  border: 1px solid #E8E8E8;
  border-radius: 12px;
  padding: 0 14px;
  box-sizing: border-box;
  background-color: #FAFAFA;
}

.input-prefix {
  font-size: 14px;
  color: #666;
  font-weight: 500;
  margin-right: 8px;
  padding-right: 8px;
  border-right: 1px solid #E0E0E0;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 14px;
  color: #333;
  height: 40px;
  box-sizing: border-box;
}

.code-btn {
  flex-shrink: 0;
  padding: 6px 14px;
  border-radius: 8px;
  background-color: #E8F4E8;
  margin-left: 10px;
}

.code-btn text {
  font-size: 13px;
  color: #5B8C5A;
  font-weight: 500;
}

.code-btn-disabled {
  background-color: #F0F0F0;
}

.code-btn-disabled text {
  color: #BFBFBF;
}

/* 手机号登录按钮 */
.phone-login-btn {
  width: 100%;
  height: 48px;
  background-color: #FFFFFF;
  border: 1px solid #5B8C5A;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-top: 16px;
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn .btn-text {
  font-size: 15px;
  color: #5B8C5A;
  font-weight: 600;
}

.phone-login-btn.login-btn-loading {
  opacity: 0.6;
}

/* 协议勾选 */
.agreement-row {
  display: flex;
  align-items: flex-start;
  margin-top: 16px;
  margin-bottom: 4px;
  padding: 6px 0;
}

.checkbox-area {
  flex-shrink: 0;
  padding-top: 2px;
  margin-right: 8px;
}

.checkbox {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid #D0D0D0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.checkbox-checked {
  border-color: #5B8C5A;
  background-color: #5B8C5A;
}

.check-mark {
  font-size: 11px;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

.agreement-text {
  flex: 1;
  font-size: 12px;
  color: #999;
  line-height: 1.6;
}

.link-text {
  color: #5B8C5A;
}

.agreement-error {
  font-size: 12px;
  color: #E85D5D;
  margin-bottom: 4px;
  padding-left: 8px;
}

/* 底部 */
.login-footer {
  padding: 20px 0 36px 0;
  display: flex;
  justify-content: center;
}

.footer-text {
  font-size: 12px;
  color: #BFBFBF;
}

/* 隐私协议弹窗 */
.privacy-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.privacy-popup {
  width: 300px;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 24px 20px 20px 20px;
  box-sizing: border-box;
}

.privacy-popup-title {
  font-size: 17px;
  font-weight: 700;
  color: #2C2C2C;
  text-align: center;
  margin-bottom: 16px;
}

.privacy-popup-body {
  font-size: 13px;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24px;
}

.privacy-link {
  color: #5B8C5A;
}

.privacy-popup-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.privacy-btn-agree {
  width: 100%;
  height: 44px;
  background: linear-gradient(135deg, #5B8C5A 0%, #6AA669 100%);
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
  margin-bottom: 12px;
}

.privacy-btn-agree::after {
  border: none;
}

.privacy-btn-deny {
  font-size: 13px;
  color: #BFBFBF;
  padding: 8px 0;
}